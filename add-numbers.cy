# Example Neo program: Adding two numbers

# Declare two numbers
var a: 10
var b: 25

# Add the numbers
var sum: a + b

# Print the result
print(sum)

# You can also do inline addition
var result: 100 + 50
print(result)

# Adding multiple numbers
var x: 5
var y: 15
var z: 30
var total: x + y + z
print(total)
